PORT=
DATABASE_URL=
# Must be at least 32 characters of high-entropy random data
JWT_SECRET=
NODE_ENV=
# Comma-separated list of allowed browser origins for CORS and WebSocket
# e.g. CORS_ORIGINS=https://pos.example.com,https://admin.example.com
CORS_ORIGINS=
# Set when running behind a reverse proxy (e.g. "1" or "loopback, linklocal, uniquelocal")
TRUST_PROXY=

# SMTP — cPanel / any SMTP provider
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Public URL of the dashboard frontend (used in email links)
APP_URL=

# Google OAuth (optional — leave blank to disable the Google sign-in button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match what you register in Google Cloud Console
GOOGLE_CALLBACK_URL=https://your-backend-domain/api/auth/google/callback
# Admin panel OAuth callback (register separately in Google Cloud Console)
GOOGLE_ADMIN_CALLBACK_URL=https://your-backend-domain/admin/auth/google/callback
# Public URL of the admin panel (used to redirect after OAuth)
ADMIN_URL=http://localhost:5174

# AI — any OpenAI-compatible endpoint (Ollama locally, vLLM/llama.cpp in prod)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
# Ignored by Ollama; required by hosted endpoints
LLM_API_KEY=
# Per-request timeout in ms (default 120000)
LLM_TIMEOUT_MS=
